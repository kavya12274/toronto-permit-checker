# Copy this file, name the copy ".env" (with the dot), and paste your key below.
# .env is private: never share it, never put it on GitHub (.gitignore already keeps it out).

# Your key from console.anthropic.com -> API keys. It starts with sk-ant-
ANTHROPIC_API_KEY=

# The cheap model. Leave as is.
AI_MODEL=claude-haiku-5-5

# Model for reading drawings. Haiku is cheapest (about $0.01 a drawing set). If it misreads messy drawings,
# try claude-sonnet-5-5 (about 20 times the price, still well under $0.50 a set).
AI_DRAWING_MODEL=claude-haiku-5-5

# The app stops sending AI requests before spending more than this (US dollars).
# Also buy only $5 of credit on console.anthropic.com with auto-reload OFF: that's the real hard limit.
AI_BUDGET_USD=5.00
